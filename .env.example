# ==============================================================================
# AI City Command Center - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your local development environment:
#    cp .env.example .env
# 2. Update the values with your local settings.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Python / FastAPI)
# ------------------------------------------------------------------------------
APP_NAME=AI City Command Center
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_city_command_center
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Frontend Application Configuration (React + Vite)
# ------------------------------------------------------------------------------
# Base API URL: routing prefix is an implementation detail to be finalized during backend setup
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_3D_VIEW=true
# Polling interval (in milliseconds) - value to be finalized during implementation/POC
VITE_POLLING_INTERVAL_MS=
# Map provider direction: MapLibre GL JS is the planned direction; implementation details subject to POC
VITE_MAP_PROVIDER=maplibre

# ------------------------------------------------------------------------------
# AI / ML Service Configuration
# ------------------------------------------------------------------------------
# Exact AI model will be selected after a local proof-of-concept
AI_SERVICE_ENABLED=true
AI_FALLBACK_MODE=true
# Confidence threshold - value to be finalized during implementation/POC
AI_CONFIDENCE_THRESHOLD=
AI_FALLBACK_DATA_PATH=./data/sample/sample_incidents.json

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL - Planned Direction)
# ------------------------------------------------------------------------------
# Note: For initial MVP development, local validated sample data may be used first.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_city_command_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# Severity & Alert Thresholds
# ------------------------------------------------------------------------------
# Threshold values to be finalized during implementation/POC
SEVERITY_HIGH_THRESHOLD=
SEVERITY_CRITICAL_THRESHOLD=
